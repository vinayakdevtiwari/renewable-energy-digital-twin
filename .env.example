# SD-03 Renewable Energy Optimization Platform Configuration
# Open-Meteo REST API works without an API key for public requests.
# If using a commercial Open-Meteo subscription key, set it below:
VITE_WEATHER_API_KEY=

# Future IoT / Machine Learning Backend Endpoints
VITE_ML_FORECAST_ENDPOINT=/api/forecast
VITE_ML_RECOMMENDATIONS_ENDPOINT=/api/recommendations
VITE_ML_ENERGY_STATUS_ENDPOINT=/api/energy-status
